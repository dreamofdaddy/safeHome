# SafeHome local development defaults
# Copy this file to .env when values need to be overridden.

APP_ENV=local

# PostgreSQL (local Docker Compose only)
POSTGRES_DB=safehome
POSTGRES_USER=safehome
POSTGRES_PASSWORD=safehome_local
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application ports
BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=5173

# LLM: keep the real key outside Git
OPENAI_API_KEY=
